# Used by ./scripts/deploy-remote.sh and:
#   docker compose --env-file .env.remote up -d --build
#
# Host ports — not 80/443. HTTP redirects to HTTPS on TOPOLOGY_HTTPS_PORT.

TOPOLOGY_BIND=192.168.1.247
TOPOLOGY_HTTP_PORT=43146
TOPOLOGY_HTTPS_PORT=43147
TOPOLOGY_IMAGE=gpu-fabric-topology:local
REMOTE_HOST=192.168.1.247
# Override when deploying via SSH Docker context:
# REMOTE_USER=drew
